<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClickyBotSetup</RootNamespace>
    <AssemblyName>ClickyBotSetup</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\artifacts\installer-staging\ClickyBot.exe">
      <LogicalName>payload/ClickyBot.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
