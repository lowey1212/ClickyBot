<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClickyBot</RootNamespace>
    <AssemblyName>ClickyBot</AssemblyName>
    <ApplicationIcon>Assets\ClickyBot.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.55</Version>
    <AssemblyVersion>0.1.55.0</AssemblyVersion>
    <FileVersion>0.1.55.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release-macros\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ClickyBot.png" />
    <Resource Include="Assets\Throne\*.png" />
    <EmbeddedResource Include="Assets\Aio2\Alt-1-prompt.png" LogicalName="ClickyBot.Aio2.Alt1.png" />
    <EmbeddedResource Include="Assets\Aio2\Auto-Move.png" LogicalName="ClickyBot.Aio2.AutoMove.png" />
    <EmbeddedResource Include="Assets\Aio2\F-prompt.png" LogicalName="ClickyBot.Aio2.F.png" />
    <EmbeddedResource Include="Assets\Aio2\Gather-prompt.png" LogicalName="ClickyBot.Aio2.Gather.png" />
    <EmbeddedResource Include="Assets\Aio2\Skip-prompt.png" LogicalName="ClickyBot.Aio2.Skip.png" />
    <EmbeddedResource Include="Assets\Aio2\Target-HP-bar.png" LogicalName="ClickyBot.Aio2.TargetBar.png" />
    <Compile Remove="installer\**" />
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
    <None Update="FAKERINPUT-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
